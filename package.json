{
	"name": "@e18e/esmodule.com",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"clear-build": "rm -rf ./.svelte-kit/cloudflare",
		"dev": "vite dev",
		"build": "pnpm clear-build && wrangler types --check && vite build",
		"preview": "wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --experimental-cli --check . && eslint .",
		"format": "prettier --experimental-cli --write .",
		"test": "vitest run",
		"gen": "pnpm clear-build && wrangler types",
		"deploy": "pnpm run build && wrangler deploy --env=\"\"",
		"deploy:preview": "pnpm run build && wrangler versions --env=\"\" upload"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@remix-run/route-pattern": "^0.23.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.2.0",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^10.8.1",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"shiki": "^4.4.2",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0",
		"wrangler": "^4.120.0"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
